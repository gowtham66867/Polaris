# Hermes API server (start it with `hermes gateway` after enabling API_SERVER_ENABLED)
POLARIS_HERMES_API_URL=http://127.0.0.1:8642/v1
POLARIS_HERMES_API_KEY=change-me-local-dev

# Select the Claude model through `hermes model`. This value is forwarded per request.
# Anthropic's current verified Opus identifier is Claude Opus 5. There is no Opus 5.5 slug.
POLARIS_HERMES_MODEL=anthropic/claude-opus-5

# The demo stays useful if Hermes is offline: deterministic guidance remains available.
POLARIS_DB_PATH=polaris-guidance.db

# `demo` permits the local dashboard. Before any shared deployment, use `strict` and provision
# keys out of band. Never commit real keys.
POLARIS_AUTH_MODE=demo
# POLARIS_API_KEYS_JSON={"replace-with-random-secret":{"subject":"nurse-1","role":"nurse"}}
